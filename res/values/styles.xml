<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!--
    No window animation. A near-black starting window suits either palette without a
    blue flash when Dark is selected.
  -->
  <style name="InstantHome" parent="@android:style/Theme.DeviceDefault.NoActionBar">
    <item name="android:windowAnimationStyle">@null</item>
    <item name="android:windowBackground">#FF030303</item>
    <item name="android:windowFullscreen">true</item>
    <item name="android:windowDisablePreview">false</item>
    <item name="android:windowContentTransitions">false</item>
    <item name="android:windowActivityTransitions">false</item>
  </style>
</resources>
